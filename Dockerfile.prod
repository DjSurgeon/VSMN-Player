# Multi-stage build: builder
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential cmake git python3-pip \
    libcurl4-openssl-dev libssl-dev \
    libavcodec-dev libavformat-dev libavutil-dev \
    libswscale-dev libswresample-dev \
    libsdl2-dev libgl1-mesa-dev

RUN pip3 install conan==2.0.0

WORKDIR /build

# Copy source
COPY . .

# Build
RUN mkdir -p build && \
    cd build && \
    conan install .. && \
    cmake .. && \
    cmake --build . --config Release && \
    ctest

# ------- Final stage: runtime
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    libcurl4 libssl3 \
    libavcodec60 libavformat60 libavutil58 \
    libswscale7 libswresample4 \
    libsdl2-2.0-0 libgl1-mesa-glx

WORKDIR /app

# Copy only binary from builder
COPY --from=builder /build/build/iptv_player /app/iptv_player

ENTRYPOINT ["/app/iptv_player"]