# Multi-stage build: builder
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential cmake git python3-pip \
    libcurl4-openssl-dev libssl-dev \
    libavcodec-dev libavformat-dev libavutil-dev \
    libswscale-dev libswresample-dev \
    libsdl2-dev libgl1-mesa-dev

RUN pip3 install "conan>=2.5.0"

WORKDIR /build

# Copy source
COPY . .

# Build
RUN conan profile detect --force && \
    conan install . --build=missing -pr conan/profiles/release -c tools.system.package_manager:mode=install -c tools.system.package_manager:sudo=False && \
    cmake -B build-release -DCMAKE_TOOLCHAIN_FILE=build/Release/generators/conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS="-O3" && \
    cmake --build build-release --parallel $(nproc)

# ------- Final stage: runtime
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    libsdl2-2.0-0 libgl1-mesa-glx libpulse0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only binary from builder
# Usar find para encontrar el binario generado por CMake
RUN mkdir -p /app/bin
COPY --from=builder /build/build-release/src/iptv_player /app/iptv_player

ENTRYPOINT ["/app/iptv_player"]