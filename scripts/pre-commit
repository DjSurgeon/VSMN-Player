#!/usr/bin/env bash
#
# Pre-commit hook to automatically run clang-format and cppcheck
# on all modified C++ files before committing.
#

set -e

# Find all staged C/C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|c|h)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "🔍 Running pre-commit checks on staged files..."

# Check if clang-format is installed
if ! command -v clang-format &> /dev/null; then
  echo "⚠️ clang-format not found. Please install it (e.g. apt install clang-format)."
  exit 1
fi

HAS_ERRORS=0

# Run clang-format
echo "🎨 Formatting code..."
for FILE in $STAGED_FILES; do
  clang-format -i "$FILE"
  # Re-add the formatted file to the staging area
  git add "$FILE"
done

# Run cppcheck if available (optional in hook)
if command -v cppcheck &> /dev/null; then
  echo "🧠 Running cppcheck..."
  cppcheck --enable=all --suppress=missingIncludeSystem --inconclusive --error-exitcode=1 $STAGED_FILES || HAS_ERRORS=1
fi

if [ $HAS_ERRORS -eq 1 ]; then
  echo "❌ Pre-commit checks failed! Please fix the errors above."
  exit 1
fi

echo "✅ All checks passed! Proceeding with commit."
exit 0
