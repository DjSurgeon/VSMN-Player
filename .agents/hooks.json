{
  "preflight-check": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/tools/preflight.sh --summary 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
